{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "kisangho-chat",
  "account_id": "7441b73749dd1f5112c9a80d17e6cb6c",
  "main": "src/index.js",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "vars": {
    "ANTHROPIC_MODEL": "claude-opus-4-6",
    "MEMORY_MODEL": "claude-sonnet-4-6",
    "DAILY_MESSAGE_LIMIT": "200"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kisangho-memory",
      "database_id": "31ba5f1b-be33-4b4d-b77f-e04869627e79",
      "migrations_dir": "migrations"
    }
  ]
}
