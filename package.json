{
  "name": "kisangho",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "db:local": "wrangler d1 migrations apply DB --local --config worker/wrangler.jsonc",
    "db:remote": "wrangler d1 migrations apply DB --remote --config worker/wrangler.jsonc",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": { "node": ">=22" }
}
